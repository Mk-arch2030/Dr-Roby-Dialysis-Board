{
  "name": "dialysis-unit-board",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "bin": "build/server.cjs",
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "outputPath": "release",
    "compress": "GZip"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "add-user": "tsx server/add-user.ts",
    "build:exe": "npm run build && node scripts/bundle-server.mjs && pkg . --targets node24-win-x64 --output release/dialysis-board.exe --no-bytecode --public",
    "build:exe:linux": "npm run build && node scripts/bundle-server.mjs && pkg . --targets node24-linux-x64 --output release/dialysis-board-linux --no-bytecode --public"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@yao-pkg/pkg": "^6.25.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
